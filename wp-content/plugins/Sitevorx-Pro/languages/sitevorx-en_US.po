msgstr "Security settings saved."

msgid "Giám sát đăng nhập"
msgstr "Login monitor"

msgid "Bẫy bot đăng nhập (Honeypot)"
msgstr "Login bot trap (Honeypot)"

msgid "Chèn ô nhập ẩn vào form đăng nhập. Bot điền vào sẽ bị từ chối, người dùng thật không thấy ô này nên không ảnh hưởng."
msgstr "Inject a hidden field into the login form. Bots that fill it are rejected; humans never see the field so they are unaffected."

msgid "Chặn truy vấn ?author=N và REST API /wp/v2/users từ khách truy cập chưa đăng nhập để hacker không thu thập được danh sách tài khoản."
msgstr "Block ?author=N queries and the REST /wp/v2/users endpoint for guests so attackers cannot harvest the user list."

msgid "Email báo khi admin đăng nhập"
msgstr "Email on admin login"

