msgid "Khóa Theme/Plugin File Editor"
msgstr "Disable Theme/Plugin File Editor"

msgid "Ngăn việc sửa nhầm mã nguồn Theme/Plugin từ giao diện admin làm sập website."
msgstr "Prevent accidental theme/plugin code edits from the admin UI that could break the site."

