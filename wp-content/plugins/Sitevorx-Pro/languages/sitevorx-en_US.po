msgstr "WordPress core integrity check"

msgid "Đối chiếu tệp core với api.wordpress.org"
msgstr "Compare core files against api.wordpress.org"

msgid "Tải MD5 chính thức của phiên bản WordPress đang chạy từ WordPress.org, sau đó so với từng file core trên server để phát hiện file bị sửa đổi hoặc thiếu. Chỉ chạy khi bạn bấm — không tự động."
msgstr "Download the official MD5 checksums for the running WordPress version from WordPress.org, then diff every core file on the server to spot modified or missing files. Runs on demand only — never automatically."

msgid "Bắt đầu kiểm tra"
msgstr "Start check"

msgid "Đang kiểm tra... có thể mất tới 30 giây."
msgstr "Checking… this can take up to 30 seconds."

