msgstr "Automatically lock IP for 1 hour if someone enters the wrong password more than 5 consecutive times."

msgid "Đổi Đường Dẫn Đăng Nhập (URL Bí Mật)"
msgstr "Change Login URL (Secret URL)"

msgid "Giấu đường link đăng nhập mặc định. Chỉ những ai biết từ khóa bí mật mới vào được."
msgstr "Hide the default login URL. Only those who know the secret keyword can access it."

msgid "Từ khóa bảo mật"
msgstr "Security keyword"

msgid "Đường dẫn truy cập:"
msgstr "Access URL:"

msgid "Củng Cố Lõi Hệ Thống"
msgstr "System Core Hardening"

msgid "Chống Quét Mật Khẩu (Khóa XML-RPC)"
msgstr "Anti-Password Scanning (Block XML-RPC)"

msgid "Đóng cổng kết nối cũ của hệ thống để chặn phần mềm dùng tấn công dò mật khẩu (Brute-force)."
msgstr "Close the legacy system port to block software used for brute-force password attacks."

msgid "Khóa Chỉnh Sửa Mã Nguồn"
msgstr "Lock Source Code Editor"

msgid "Ngăn chặn việc lỡ tay sửa nhầm mã nguồn Theme/Plugin từ giao diện làm sập website."
msgstr "Prevent accidental source code edits of Theme/Plugin from the admin panel that could crash the website."

msgid "Thực thi chuỗi mã hóa / giải nén qua eval"
msgstr "Execute encoded/compressed string via eval"

