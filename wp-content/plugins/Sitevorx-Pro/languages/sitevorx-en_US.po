msgstr "Send mail to %s whenever a manage_options account logs in successfully."

msgid "Giới hạn 1 email/giờ cho mỗi IP để tránh spam. Đổi địa chỉ nhận tại Cài đặt → Tổng quan → Địa chỉ Email của trang."
msgstr "Throttled to 1 email per IP per hour. Change the recipient at Settings → General → Site Email."

msgid "Đã lưu cấu hình giám sát"
msgstr "Monitor settings saved"

