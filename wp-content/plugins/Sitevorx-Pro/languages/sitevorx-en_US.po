msgstr "System command execution from input data or encoded string"

msgid "Sử dụng preg_replace với modifier /e"
msgstr "Using preg_replace with /e modifier"

msgid "Thực thi động từ dữ liệu không tin cậy"
msgstr "Dynamic execution from untrusted data"

msgid "Chữ ký web shell phổ biến"
msgstr "Common web shell signature"

msgid "Chữ ký web shell WSO"
msgstr "WSO web shell signature"

msgid "Giải mã trực tiếp dữ liệu đầu vào"
msgstr "Direct decoding of input data"

msgid "Chuỗi giải mã / giải nén nhiều lớp"
msgstr "Multi-layer decode/decompress chain"

msgid "Có sử dụng hàm thực thi lệnh hệ thống"
msgstr "System command execution function detected"

msgid "Chuỗi mã hóa dài được giải mã trực tiếp"
msgstr "Long encoded string decoded directly"

msgid "Trình Quét Mã Độc Toàn Diện"
msgstr "Comprehensive Malware Scanner"

msgid "Quét đệ quy tất cả file .php (Core, Themes, Plugins) trên toàn bộ Server và phân tích Database để tìm kiếm các chữ ký Shell, Backdoor. Thời gian quét có thể từ 30-90 giây tùy dung lượng."
msgstr "Recursively scan all .php files (Core, Themes, Plugins) across the entire Server and analyze the Database to find Shell and Backdoor signatures. Scan time may take 30-90 seconds depending on size."

msgid "Đang quét toàn bộ hệ thống (File + DB)..."
msgstr "Scanning entire system (Files + DB)..."

msgid "Bắt đầu quét chuyên sâu"
msgstr "Start deep scan"

msgid "Không phát hiện mã độc!"
msgstr "No malware detected!"

msgid "Đã quét %s đối tượng (File PHP + Database Records) trên toàn bộ Server WP. Hệ thống hiện tại an toàn tuyệt đối."
msgstr "Scanned %s objects (PHP files + Database records) across the entire WP Server. System is currently absolutely safe."

msgid "Phát hiện %d file nghi ngờ!"
msgstr "Detected %d suspicious file(s)!"

msgid "Đã quét %s file. Vui lòng kiểm tra các file bên dưới."
msgstr "Scanned %s files. Please review the files below."

msgid "Đường dẫn File"
msgstr "File Path"

msgid "Loại đe dọa"
msgstr "Threat Type"

msgid "Kích thước"
msgstr "Size"

