msgstr "IP temporarily locked for 1 hour due to too many failed attempts."

msgid "Đã cập nhật các thiết lập tối ưu hệ thống."
msgstr "System optimization settings updated."

msgid "Cấu hình bảo mật đã được áp dụng thành công."
msgstr "Security configuration has been applied successfully."

msgid "Hoàn tất dọn dẹp dữ liệu hệ thống"
msgstr "System data cleanup completed"

msgid "Nâng cấp hiệu suất và bảo vệ Website toàn diện khỏi các nguy cơ tấn công từ bên ngoài."
msgstr "Enhance performance and comprehensively protect your Website from external threats."

msgid "Tăng Tốc Website"
msgstr "Speed Boost"

msgid "Bảo Mật & Tường Lửa"
msgstr "Security & Firewall"

msgid "Quét Mã Độc"
msgstr "Malware Scanner"

msgid "Dọn Rác Hệ Thống"
msgstr "System Cleanup"

msgid "Xóa Bản Nháp (Revisions)"
msgstr "Delete Revisions"

msgid "Các bài viết cũ thường lưu rất nhiều bản nháp gây nặng máy chủ. Nút này sẽ dọn dẹp chúng."
msgstr "Old posts often store many revisions that burden the server. This button will clean them up."

msgid "Dọn Bình Luận Rác"
msgstr "Clean Spam Comments"

msgid "Xóa vĩnh viễn các bình luận đang nằm trong thùng rác hoặc bị đánh dấu là spam."
msgstr "Permanently delete comments in trash or marked as spam."

msgid "Dọn File Tạm (Transients)"
msgstr "Clean Transients"

msgid "Bộ nhớ tạm thời của website đôi khi bị đầy gây chậm, xóa đi sẽ dọn sạch để máy chủ nhẹ hơn."
msgstr "Website temporary cache can sometimes fill up causing slowdowns, clearing it will lighten the server."

msgid "Chạy dọn dẹp"
msgstr "Run cleanup"

msgid "Tối Ưu Nâng Cao"
msgstr "Advanced Optimization"

msgid "Tải Ảnh Chậm (Lazy Load)"
msgstr "Lazy Load Images"

msgid "Chỉ tải hình ảnh khi người dùng cuộn tới. Giúp trang chủ tải cực nhanh và tiết kiệm băng thông."
msgstr "Only load images when users scroll to them. Makes homepage load very fast and saves bandwidth."

msgid "Giảm Tải Máy Chủ (Heartbeat)"
msgstr "Reduce Server Load (Heartbeat)"

msgid "Tắt các tiến trình ngầm không quan trọng (Heartbeat API) để Hosting/VPS của bạn không bị quá tải."
msgstr "Disable non-essential background processes (Heartbeat API) to prevent your Hosting/VPS from overloading."

msgid "Chặn Cập Nhật Tự Động"
msgstr "Block Auto Updates"

msgid "Tránh tình trạng vỡ giao diện website một cách bất ngờ do WordPress tự động cập nhật phiên bản mới."
msgstr "Prevent unexpected layout breakage caused by WordPress auto-updating to new versions."

msgid "Giới Hạn Bản Nháp (Tối đa 5)"
msgstr "Limit Revisions (Max 5)"

msgid "Ngăn chặn việc 1 bài viết lưu hàng trăm bản nháp làm phình to dung lượng Database."
msgstr "Prevent a single post from storing hundreds of revisions that bloat the database."

msgid "Cho phép Upload file SVG"
msgstr "Allow SVG Upload"

msgid "Mở khóa tính năng tải lên Icon và hình ảnh vector định dạng .svg siêu nhẹ và sắc nét."
msgstr "Unlock the ability to upload ultra-light and crisp .svg vector icons and images."

msgid "Lưu tùy chỉnh"
msgstr "Save settings"

msgid "Chống Spam Đăng Nhập (reCAPTCHA v2)"
msgstr "Anti-Spam Login (reCAPTCHA v2)"

msgid "Ngăn chặn các phần mềm tự động (Bot) cố gắng đoán mật khẩu đăng nhập. %sLấy Key bảo mật tại đây%s."
msgstr "Block automated software (Bots) from guessing login passwords. %sGet security keys here%s."

msgid "Khóa Tự Động Đăng Nhập"
msgstr "Auto Lock Login"

msgid "Bảo Mật Trang Đăng Nhập"
msgstr "Login Page Security"

msgid "Khóa IP Truy Cập Trái Phép"
msgstr "Block Unauthorized IP Access"

