msgstr "Server connection error."

msgid "File không nằm trong danh sách cho phép."
msgstr "File is not in the allow-list."

msgid "File %s không tồn tại."
msgstr "File %s does not exist."

msgid "PHP không có quyền đổi chmod (%1$s → %2$s). Hosting có thể đang chạy PHP-FPM với user khác file owner. Hãy SSH/FTP đổi tay: chmod %3$s %4$s"
msgstr "PHP cannot change chmod (%1$s → %2$s). The host probably runs PHP-FPM as a different user from the file owner. Change it manually over SSH/FTP: chmod %3$s %4$s"

msgid "Đã đổi quyền %1$s từ %2$s sang %3$s."
msgstr "Permissions of %1$s changed from %2$s to %3$s."

msgid "Đã xóa nhật ký đăng nhập thất bại"
msgstr "Failed-login log cleared"

msgid "Đã xóa tất cả IP bị khóa"
msgstr "All locked IPs cleared"

msgid "Đã xóa tất cả khóa IP."
msgstr "All IP locks cleared."

msgid "Thông số quét"
msgstr "Scanner parameters"

msgid "Bộ chữ ký"
msgstr "Signature set"

msgid "pattern"
msgstr "patterns"

msgid "Critical + heuristic patterns: eval, base64_decode, shell_exec, web shells."
msgstr "Critical + heuristic patterns: eval, base64_decode, shell_exec, web shells."

msgid "Phạm vi"
msgstr ".scope"

msgid ".php files + DB posts"
msgstr ".php files + DB posts"

msgid "Quét đệ quy %s, bỏ qua backup/cache directories và thư viện third-party."
msgstr "Recursively scan %s, skipping backup/cache directories and third-party libraries."

msgid "Giới hạn / lần"
msgstr "Per-run limits"

msgid "Timeout 30s, bỏ qua file > 2MB, dừng khi đủ 50 hit để tránh treo server."
msgstr "30s timeout, skip files larger than 2MB, stop at 50 hits to avoid stalling the server."

msgid "Lần quét trước"
msgstr "Previous scan"

msgid "✓ Sạch · %s đối tượng"
msgstr "✓ Clean · %s objects"

msgid "⚠ %1$d nghi ngờ / %2$s đối tượng"
msgstr "⚠ %1$d suspicious / %2$s objects"

msgid "Trình quét mã độc chuyên sâu"
msgstr "Deep malware scanner"

msgid "Bấm <strong>Bắt đầu quét</strong> để chạy ngay. Quá trình dùng <code>token_get_all()</code> để tách comment + string literal trước khi match regex — tránh false positive trên code hợp pháp đề cập tới hàm nguy hiểm trong comment hoặc docstring."
msgstr "Click <strong>Start scan</strong> to run. The scanner uses <code>token_get_all()</code> to strip comments + string literals before running regex matches — that avoids false positives on legitimate code that mentions dangerous functions inside comments or docstrings."

msgid "Bỏ qua các thư mục backup phổ biến (updraftplus, wordfence, litespeed-cache, woocommerce backups, rank-math) và core libraries (Requests, SimplePie, ID3, pomo) để giảm tiếng ồn."
msgstr "Skips common backup directories (updraftplus, wordfence, litespeed-cache, woocommerce backups, rank-math) and core libraries (Requests, SimplePie, ID3, pomo) to reduce noise."

msgid "Quét lần cuối %s trước"
msgstr "Last scan %s ago"

msgid "Đã quét %s đối tượng. Hệ thống an toàn."
msgstr "Scanned %s objects. System is clean."

msgid "Đã quét %s đối tượng. Mở từng file bằng FTP/SSH để xác nhận trước khi xóa — đôi khi plugin nén code hợp pháp cũng bị nghi."
msgstr "Scanned %s objects. Open each file via FTP/SSH to confirm before deleting — some legitimate plugin code is heavily packed and may trip detection."

msgid "Quét %s đối tượng, %d nghi ngờ"
msgstr "Scanned %s objects, %d suspicious"

msgid "⏳ Đang quét..."
msgstr "⏳ Scanning…"

msgid "Đường dẫn"
msgstr "Path"

msgid "Critical signature"
msgstr "Critical signature"

msgid "Gọi lệnh hệ thống từ dữ liệu đầu vào"
msgstr "System command call from input data"

msgid "preg_replace với modifier /e"
msgstr "preg_replace with /e modifier"

msgid "Hàm thực thi lệnh hệ thống"
msgstr "System command execution function"

msgid "Chuỗi giải mã nhiều lớp"
msgstr "Multi-layered decode chain"

msgid "Chuỗi mã hóa dài được giải mã"
msgstr "Long encoded string being decoded"

msgid "Gỡ Script Thừa (Frontend Bloat)"
msgstr "Strip Unused Scripts (Frontend Bloat)"

msgid "Tắt Emoji của WordPress"
msgstr "Disable WordPress Emoji"

msgid "Gỡ script wp-emoji-release.min.js (~15KB) và style emoji khỏi mọi trang. Trình duyệt hiện đại đã hiển thị emoji native, không cần WP hỗ trợ riêng."
msgstr "Remove wp-emoji-release.min.js (~15KB) and emoji styles from every page. Modern browsers render emoji natively — WP's helper is no longer needed."

msgid "Tắt oEmbed (nhúng URL tự động)"
msgstr "Disable oEmbed (auto URL embed)"

msgid "Gỡ wp-embed.min.js (~12KB) + endpoint /oembed/. Tắt khi không dán link YouTube/Twitter trực tiếp trong post (vẫn nhúng được qua iframe thủ công)."
msgstr "Remove wp-embed.min.js (~12KB) + the /oembed/ endpoint. Disable when you don't paste YouTube/Twitter links directly into posts (manual iframe embeds still work)."

msgid "Gỡ jQuery Migrate"
msgstr "Remove jQuery Migrate"

msgid "Gỡ jquery-migrate.min.js (~10KB) — chỉ cần cho theme/plugin cực cũ dùng jQuery 1.x API. Nếu site hoạt động bình thường sau khi tắt → để tắt luôn."
msgstr "Remove jquery-migrate.min.js (~10KB) — only needed for ancient themes/plugins on the jQuery 1.x API. If the site works fine after disabling, leave it off."

msgid "Dọn wp_head"
msgstr "Clean up wp_head"

msgid "Gỡ các meta tag không cần thiết: WP generator (lộ version), RSD link, wlwmanifest (Windows Live Writer), shortlink. Giảm 5-7 dòng HTML không ai dùng."
msgstr "Remove unused meta tags: WP generator (leaks version), RSD link, wlwmanifest (Windows Live Writer), shortlink. 5-7 lines of dead HTML gone."

msgid "Tắt Trackback / Pingback"
msgstr "Disable Trackback / Pingback"

msgid "Tắt cơ chế trackback (đa số site không dùng) — vừa giảm spam comment, vừa chặn DDoS amplification qua pingback.ping."
msgstr "Disable the trackback mechanism (most sites don't use it) — cuts spam comments and blocks DDoS amplification via pingback.ping."

msgid "Tắt Emoji"
msgstr "Disable Emoji"

msgid "Tắt oEmbed"
